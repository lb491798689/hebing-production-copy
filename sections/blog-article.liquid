      "id": "sticky_aside",
      "label": "Sticky aside on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_continue_reading",
      "label": "Show continue reading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_advertising",
      "label": "Show advertising",
      "default": true
    }
