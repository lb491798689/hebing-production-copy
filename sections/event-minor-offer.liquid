{% assign enable_mock_variants = false %}
{%- liquid
  assign configured_tabs = section.settings.tabs | newline_to_br | split: '<br />'
  assign has_tabs = false
  assign first_tab_handle = ''

  for tab_label in configured_tabs
    assign tab_label = tab_label | strip
    if tab_label == blank
      continue
    endif

    assign has_tabs = true
    if first_tab_handle == blank
      assign first_tab_handle = tab_label | handleize
    endif
  endfor
-%}

<section
  id="{{ section.id }}"
  class="
    event-minor-offer event-minor-offer--{{ section.settings.color_mode }}
    tw:font-gabarito
  "
  style="
    --event-minor-offer-padding-top: {{ section.settings.padding_top }}px;
    --event-minor-offer-padding-bottom: {{ section.settings.padding_bottom }}px;
    --event-minor-offer-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --event-minor-offer-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --event-minor-offer-row-count: {{ section.settings.row_count }};
    --event-minor-offer-background-color: {{ section.settings.background_color | default: '#0a0227' }};
  "
>
  <div class="tw:mx-auto tw:flex tw:w-full tw:max-w-[1200px] tw:flex-col tw:gap-8 tw:max-md:px-4">
    {%- if section.settings.title != blank or has_tabs -%}
      <div class="event-minor-offer__header tw:flex tw:flex-col tw:items-center tw:gap-4">
        {%- if section.settings.title != blank -%}
          <h2
            class="
              event-minor-offer__title tw:m-0 tw:text-center tw:font-gabarito tw:text-[48px] tw:font-black
              tw:leading-[normal] tw:tracking-normal
              tw:max-md:text-[32px]
            "
          >
            {{ section.settings.title | escape | newline_to_br }}
          </h2>
        {%- endif -%}

        {%- if has_tabs -%}
          {%- assign active_tab_assigned = false -%}
          <div
            class="event-minor-offer__tabs tw:w-full tw:px-4 tw:max-md:px-0"
            role="tablist"
            aria-label="{{ section.settings.title | default: 'Product groups' | escape }}"
            data-event-minor-offer-tabs
          >
            {%- for tab_label in configured_tabs -%}
              {%- liquid
                assign tab_label = tab_label | strip
                if tab_label == blank
                  continue
                endif

                assign tab_handle = tab_label | handleize
                assign is_active_tab = false
                if active_tab_assigned == false
                  assign is_active_tab = true
                  assign active_tab_assigned = true
                endif
              -%}
              <button
                type="button"
                class="event-minor-offer__tab tw:font-orbitron tw:font-bold tw:uppercase!"
                id="event-minor-offer-tab-{{ section.id }}-{{ forloop.index }}"
                role="tab"
                aria-selected="{% if is_active_tab %}true{% else %}false{% endif %}"
                aria-controls="event-minor-offer-grid-{{ section.id }}"
                tabindex="{% if is_active_tab %}0{% else %}-1{% endif %}"
                data-event-minor-offer-tab
                data-tab-handle="{{ tab_handle | escape }}"
              >
                {{ tab_label | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        id="event-minor-offer-grid-{{ section.id }}"
        class="event-minor-offer__grid tw:grid tw:gap-3 tw:max-md:grid-cols-1"
        data-event-minor-offer-grid
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_tab = block.settings.tab | strip
            assign block_tab_handle = block_tab | handleize
            assign is_tab_hidden = false
            if has_tabs and block_tab != blank and block_tab_handle != first_tab_handle
              assign is_tab_hidden = true
            endif

            assign product = block.settings.product
            assign current_variant = null
            assign default_product_title = 'AutoFull M6 Ultra Gaming Chair & A4 Pro Gaming Desk Bundle'
            if forloop.index == 2
              assign default_product_title = 'AutoFull G7 Gaming Chair & A4 Pro Gaming Desk Bundle [💥Combo Off]'
            elsif forloop.index == 3
              assign default_product_title = 'AutoFull A4 Pro RGB Gaming Desk'
            endif

            if product != blank
              assign current_variant = product.selected_or_first_available_variant
              if current_variant == blank
                assign current_variant = product.variants.first
              endif
            endif

            assign product_title = block.settings.product_title
            if product_title == blank and product != blank
              assign product_title = product.title
            endif
            if product_title == blank
              assign product_title = default_product_title
            endif

            assign product_image = block.settings.product_image
            if product_image == blank and current_variant != blank
              assign product_image = current_variant.featured_image | default: current_variant.featured_media.preview_image
            endif
            if product_image == blank and product != blank
              assign product_image = product.featured_image
            endif

            assign compare_price = current_variant.compare_at_price
            assign price = current_variant.price
            assign display_price = price | money
            assign display_compare_price = compare_price | money
            assign show_discount = false
            assign discount_amount_text = blank
            assign price_off_text = blank
            if compare_price != blank and price != blank and compare_price > price
              assign show_discount = true
              assign discount_amount = compare_price | minus: price
              assign discount_amount_text = discount_amount | money_without_trailing_zeros
              assign price_off_text = discount_amount_text | append: ' OFF'
            elsif current_variant == blank
              assign show_discount = true
              assign display_price = '$390.00'
              assign display_compare_price = '$490.00'
              assign discount_amount_text = '$200'
              assign price_off_text = '$100 OFF'
            endif

            assign learn_more_link = block.settings.learn_more_btn_link
            if learn_more_link == blank and product != blank
              assign learn_more_link = product.url
            endif
            if learn_more_link == blank
              assign learn_more_link = '#'
            endif

            assign mock_variant_id = ''
            assign mock_variant_available = 'true'
            assign mock_variant_image = ''
            if current_variant != blank
              assign mock_variant_id = current_variant.id
              if current_variant.available == false
                assign mock_variant_available = 'false'
              endif
            endif
            if product_image != blank
              assign mock_variant_image = product_image | image_url: width: 700
            endif

            assign current_variant_color = current_variant.metafields.custom.color_code | default: current_variant.option1
            assign current_variant_swatch_image = ''
            if current_variant != blank
              assign current_swatch_label = current_variant.option1 | default: current_variant.title | downcase | strip
              assign current_swatch_full_name = current_swatch_label | replace: ' ', '-'
              assign current_swatch_candidates_str = current_swatch_full_name
              assign current_swatch_words = current_swatch_label | split: ' ' | reverse
              for current_swatch_word in current_swatch_words
                assign current_swatch_candidates_str = current_swatch_candidates_str | append: '|' | append: current_swatch_word
              endfor
              assign current_swatch_candidates = current_swatch_candidates_str | split: '|'
              assign current_swatch_extensions = 'png,svg,webp,jpg,jpeg' | split: ','
              for current_swatch_candidate in current_swatch_candidates
                if current_variant_swatch_image != blank
                  break
                endif
                assign current_swatch_candidate = current_swatch_candidate | strip
                if current_swatch_candidate == blank
                  continue
                endif
                for current_swatch_extension in current_swatch_extensions
                  assign current_swatch_asset_name = 'swatch-' | append: current_swatch_candidate | append: '.' | append: current_swatch_extension
                  assign current_swatch_asset = current_swatch_asset_name | asset_url
                  if current_swatch_asset != blank and current_swatch_asset contains current_swatch_asset_name
                    assign current_variant_swatch_image = current_swatch_asset
                    break
                  endif
                endfor
              endfor
            endif
          -%}

          <article
            class="event-minor-offer__card tw:relative tw:flex tw:min-h-[510px] tw:flex-col tw:overflow-visible tw:rounded-xl tw:max-md:min-h-0"
            data-event-minor-offer-card
            data-event-minor-offer-card-tab="{{ block_tab_handle | escape }}"
            {% if is_tab_hidden %}
              hidden
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <a
              href="{{ learn_more_link }}"
              class="event-minor-offer__card-link"
              aria-label="{{ block.settings.learn_more_btn_text | default: 'Learn more' | escape }}: {{ product_title | escape }}"
            ></a>

            <div class="event-minor-offer__media tw:relative tw:h-[280px] tw:w-full tw:shrink-0 tw:overflow-hidden tw:rounded-t-xl">
              <div class="tw:absolute tw:left-1/2 tw:top-1/2 tw:flex tw:size-[280px] tw:-translate-x-1/2 tw:-translate-y-1/2 tw:items-center tw:justify-center">
                {%- if product_image != blank -%}
                  {{
                    product_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '280,358,392,560,700',
                      sizes: '(min-width: 1150px) 280px, 280px',
                      class: 'event-minor-offer__image tw:h-full tw:w-full tw:object-contain',
                      alt: product_image.alt
                  }}
                {%- else -%}
                  <div class="event-minor-offer__image tw:h-full tw:w-full tw:bg-black/5"></div>
                {%- endif -%}
              </div>

              {%- if section.settings.label_bg_image != blank -%}
                <div
                  class="
                    event-minor-offer__label
                    {% unless show_discount %}tw:hidden{% endunless %}
                  "
                  style="color: {{ section.settings.label_text_color | default: '#ffffff' }}; background-image: url('{{ section.settings.label_bg_image | image_url: width: 160 }}');"
                  data-off-label
                >
                  <span class="event-minor-offer__label-text">
                    <span class="event-minor-offer__label-amount" data-off-amount>
                      {{- discount_amount_text | strip_html -}}
                    </span>
                    <span class="event-minor-offer__label-suffix">{{ section.settings.off_text | default: 'OFF' | escape }}</span>
                  </span>
                </div>
              {%- endif -%}
            </div>

            <div class="event-minor-offer__content tw:flex tw:flex-1 tw:flex-col tw:justify-between tw:gap-6 tw:rounded-b-xl tw:p-6 tw:max-md:gap-5 tw:max-md:px-4 tw:max-md:py-6">
              <div class="tw:flex tw:flex-col tw:gap-3 tw:pb-3">
                <h3
                  class="
                    event-minor-offer__product-title tw:m-0 tw:text-[24px] tw:font-semibold
                    tw:leading-[normal] tw:max-md:text-[20px] tw:font-gabarito
                  "
                >
                  {{ product_title | escape | newline_to_br }}
                </h3>
              </div>

              <div class="tw:flex tw:flex-col tw:gap-3 tw:max-md:gap-2">
                {%- if product != blank and product.variants.size > 1 -%}
                  <div class="event-minor-offer__variant-row tw:flex tw:items-center tw:justify-between tw:gap-4 tw:border-b tw:pb-3 tw:max-md:pb-2">
                    <span class="event-minor-offer__color-label tw:text-[16px] tw:font-normal tw:leading-[normal] tw:max-md:text-[14px]"
                      >color</span
                    >

                    <div class="event-minor-offer__variant-select tw:relative" data-variant-select>
                      <button
                        type="button"
                        class="
                          event-minor-offer__variant-toggle tw:text-[14px] tw:flex tw:h-8 tw:w-[180px]
                          tw:items-center tw:justify-between tw:gap-3 tw:rounded-[999px] tw:max-md:gap-1 tw:px-1.5
                        "
                        aria-haspopup="listbox"
                        aria-expanded="false"
                        data-variant-toggle
                      >
                        <span class="tw:flex tw:items-center tw:gap-1">
                          <span
                            class="event-minor-offer__swatch"
                            style="background-color: {{ current_variant_color | escape }};{% if current_variant_swatch_image != blank %} background-image: url('{{ current_variant_swatch_image }}');{% endif %}"
                            data-selected-swatch
                          ></span>
                          <span class="tw:text-[14px] tw:font-medium" data-selected-title>
                            {{- current_variant.title | escape -}}
                          </span>
                        </span>
                        <span aria-hidden="true" class="tw:flex tw:items-center">
                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M9.99902 14.5115L3.57715 8.0896L4.75488 6.91089L9.99902 12.155L15.2432 6.91089L16.4219 8.0896L9.99902 14.5115Z" fill="currentColor"/>
                          </svg>
                        </span>
                      </button>

                      <div
                        class="event-minor-offer__variant-list tw:absolute tw:left-0 tw:top-[calc(100%+6px)] tw:z-10 tw:min-w-full tw:rounded tw:p-1 tw:shadow-[0_8px_24px_rgba(0,0,0,0.16)]"
                        role="listbox"
                        aria-hidden="true"
                        data-variant-list
                      >
                        {%- for variant in product.variants -%}
                          {%- liquid
                            assign variant_image = variant.featured_image | default: variant.featured_media.preview_image | default: product_image
                            assign variant_color = variant.metafields.custom.color_code | default: variant.option1
                            assign variant_swatch_image = ''
                            assign variant_swatch_label = variant.option1 | default: variant.title | downcase | strip
                            assign variant_swatch_full_name = variant_swatch_label | replace: ' ', '-'
                            assign variant_swatch_candidates_str = variant_swatch_full_name
                            assign variant_swatch_words = variant_swatch_label | split: ' ' | reverse
                            for variant_swatch_word in variant_swatch_words
                              assign variant_swatch_candidates_str = variant_swatch_candidates_str | append: '|' | append: variant_swatch_word
                            endfor
                            assign variant_swatch_candidates = variant_swatch_candidates_str | split: '|'
                            assign variant_swatch_extensions = 'png,svg,webp,jpg,jpeg' | split: ','
                            for variant_swatch_candidate in variant_swatch_candidates
                              if variant_swatch_image != blank
                                break
                              endif
                              assign variant_swatch_candidate = variant_swatch_candidate | strip
                              if variant_swatch_candidate == blank
                                continue
                              endif
                              for variant_swatch_extension in variant_swatch_extensions
                                assign variant_swatch_asset_name = 'swatch-' | append: variant_swatch_candidate | append: '.' | append: variant_swatch_extension
                                assign variant_swatch_asset = variant_swatch_asset_name | asset_url
                                if variant_swatch_asset != blank and variant_swatch_asset contains variant_swatch_asset_name
                                  assign variant_swatch_image = variant_swatch_asset
                                  break
                                endif
                              endfor
                            endfor
                            assign variant_compare = variant.compare_at_price
                            assign variant_price = variant.price
                            assign variant_show_discount = false
                            assign variant_discount_amount = blank
                            if variant_compare != blank and variant_price != blank and variant_compare > variant_price
                              assign variant_show_discount = true
                              assign variant_discount_amount = variant_compare | minus: variant_price
                            endif
                          -%}
                          <button
                            type="button"
                            class="event-minor-offer__variant-option tw:flex tw:w-full tw:items-center tw:gap-2 tw:rounded tw:px-2 tw:py-1.5 tw:text-left tw:text-[14px]"
                            role="option"
                            aria-selected="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                            data-variant-option
                            data-variant-id="{{ variant.id }}"
                            data-variant-title="{{ variant.title | escape }}"
                            data-variant-color="{{ variant_color | escape }}"
                            data-variant-swatch-image="{{ variant_swatch_image | escape }}"
                            data-variant-available="{% if variant.available %}true{% else %}false{% endif %}"
                            data-variant-price="{{ variant.price | money | strip_html | escape }}"
                            data-variant-compare="{{ variant.compare_at_price | money | strip_html | escape }}"
                            data-variant-has-discount="{% if variant_show_discount %}true{% else %}false{% endif %}"
                            data-variant-off="{{ variant_discount_amount | money_without_trailing_zeros }}"
                            data-variant-price-off="{{ variant_discount_amount | money_without_trailing_zeros }} OFF"
                            data-variant-coupon-off="{{ variant_discount_amount | money_without_trailing_zeros }}"
                            data-variant-image="{% if variant_image != blank %}{{ variant_image | image_url: width: 700 }}{% endif %}"
                          >
                            <span
                              class="event-minor-offer__swatch"
                              style="background-color: {{ variant_color | escape }};{% if variant_swatch_image != blank %} background-image: url('{{ variant_swatch_image }}');{% endif %}"
                            ></span>
                            <span>{{ variant.title | escape }}</span>
                          </button>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- elsif enable_mock_variants -%}
                  <div class="event-minor-offer__variant-row tw:flex tw:items-center tw:justify-between tw:gap-4 tw:border-b tw:pb-3 tw:max-md:pb-2">
                    <span class="event-minor-offer__color-label tw:text-[16px] tw:font-normal tw:leading-[normal] tw:max-md:text-[14px]"
                      >color</span
                    >

                    <div class="event-minor-offer__variant-select tw:relative" data-variant-select>
                      <button
                        type="button"
                        class="event-minor-offer__variant-toggle tw:text-[14px] tw:flex tw:h-8 tw:w-[160px] tw:items-center tw:justify-between tw:gap-3 tw:rounded-[999px] tw:max-md:gap-1 tw:px-1.5 tw:max-md:w-[146px]"
                        aria-haspopup="listbox"
                        aria-expanded="false"
                        data-variant-toggle
                      >
                        <span class="tw:flex tw:items-center tw:gap-1">
                          <span
                            class="event-minor-offer__swatch"
                            style="background: #111111;"
                            data-selected-swatch
                          ></span>
                          <span class="tw:text-[14px] tw:font-medium" data-selected-title>Black</span>
                        </span>
                        <span aria-hidden="true" class="tw:flex tw:items-center">
                          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M9.99902 14.5115L3.57715 8.0896L4.75488 6.91089L9.99902 12.155L15.2432 6.91089L16.4219 8.0896L9.99902 14.5115Z" fill="currentColor"/>
                          </svg>
                        </span>
                      </button>

                      <div
                        class="event-minor-offer__variant-list tw:absolute tw:left-0 tw:top-[calc(100%+6px)] tw:z-10 tw:min-w-full tw:rounded tw:p-1 tw:shadow-[0_8px_24px_rgba(0,0,0,0.16)]"
                        role="listbox"
                        aria-hidden="true"
                        data-variant-list
                      >
                        <button
                          type="button"
                          class="event-minor-offer__variant-option tw:flex tw:w-full tw:items-center tw:gap-2 tw:rounded tw:px-2 tw:py-1.5 tw:text-left tw:text-[14px]"
                          role="option"
                          aria-selected="true"
                          data-variant-option
                          data-variant-id="{{ mock_variant_id }}"
                          data-variant-title="Black"
                          data-variant-color="#111111"
                          data-variant-available="{{ mock_variant_available }}"
                          data-variant-price="{{ display_price | strip_html | escape }}"
                          data-variant-compare="{{ display_compare_price | strip_html | escape }}"
                          data-variant-has-discount="{% if show_discount %}true{% else %}false{% endif %}"
                          data-variant-off="{{ discount_amount_text }}"
                          data-variant-price-off="{{ price_off_text }}"
                          data-variant-coupon-off="{{ discount_amount_text }}"
                          data-variant-image="{{ mock_variant_image }}"
                        >
                          <span class="event-minor-offer__swatch" style="background: #111111;"></span>
                          <span>Black</span>
                        </button>
                        <button
                          type="button"
                          class="event-minor-offer__variant-option tw:flex tw:w-full tw:items-center tw:gap-2 tw:rounded tw:px-2 tw:py-1.5 tw:text-left tw:text-[14px]"
                          role="option"
                          aria-selected="false"
                          data-variant-option
                          data-variant-id="{{ mock_variant_id }}"
                          data-variant-title="Blue"
                          data-variant-color="#005bee"
                          data-variant-available="{{ mock_variant_available }}"
                          data-variant-price="{{ display_price | strip_html | escape }}"
                          data-variant-compare="{{ display_compare_price | strip_html | escape }}"
                          data-variant-has-discount="{% if show_discount %}true{% else %}false{% endif %}"
                          data-variant-off="{{ discount_amount_text }}"
                          data-variant-price-off="{{ price_off_text }}"
                          data-variant-coupon-off="{{ discount_amount_text }}"
                          data-variant-image="{{ mock_variant_image }}"
                        >
                          <span class="event-minor-offer__swatch" style="background: #005bee;"></span>
                          <span>Blue</span>
                        </button>
                        <button
                          type="button"
                          class="event-minor-offer__variant-option tw:flex tw:w-full tw:items-center tw:gap-2 tw:rounded tw:px-2 tw:py-1.5 tw:text-left tw:text-[14px]"
                          role="option"
                          aria-selected="false"
                          data-variant-option
                          data-variant-id="{{ mock_variant_id }}"
                          data-variant-title="Pink"
                          data-variant-color="#ee00d2"
                          data-variant-available="{{ mock_variant_available }}"
                          data-variant-price="{{ display_price | strip_html | escape }}"
                          data-variant-compare="{{ display_compare_price | strip_html | escape }}"
                          data-variant-has-discount="{% if show_discount %}true{% else %}false{% endif %}"
                          data-variant-off="{{ discount_amount_text }}"
                          data-variant-price-off="{{ price_off_text }}"
                          data-variant-coupon-off="{{ discount_amount_text }}"
                          data-variant-image="{{ mock_variant_image }}"
                        >
                          <span class="event-minor-offer__swatch" style="background: #ee00d2;"></span>
                          <span>Pink</span>
                        </button>
                      </div>
                    </div>
                  </div>
                {%- elsif current_variant != blank -%}
                  <input type="hidden" data-single-variant-id value="{{ current_variant.id }}">
                {%- endif -%}

                <div class="tw:flex tw:items-center tw:gap-2">
                  <span
                    class="event-minor-offer__price tw:text-[24px] tw:font-semibold tw:leading-[normal] tw:max-md:text-[20px]"
                    data-price
                  >
                    {{ display_price }}
                  </span>
                  <span
                    class="
                      event-minor-offer__compare-price tw:text-[20px] tw:font-normal tw:leading-[normal] tw:line-through tw:max-md:text-[16px]
                      {% unless show_discount %}tw:hidden{% endunless %}
                    "
                    data-compare-price
                  >
                    {%- if show_discount -%}{{ display_compare_price }}{%- endif -%}
                  </span>
                  <span
                    class="
                      event-minor-offer__price-off tw:rounded-[999px] tw:px-3 tw:py-1 tw:text-[14px] tw:font-medium tw:leading-[normal] tw:max-md:text-[12px]
                      {% unless show_discount %}tw:hidden{% endunless %}
                    "
                    data-price-off
                  >
                    {%- if show_discount -%}{{ price_off_text }}{%- endif -%}
                  </span>
                </div>

                <div class="tw:flex tw:h-12 tw:gap-3 tw:max-md:h-10 tw:max-md:gap-2">
                  {%- if block.settings.learn_more_btn_text != blank -%}
                    <a
                      href="{{ learn_more_link }}"
                      class="
                        event-minor-offer__learn-more tw:flex tw:h-12 tw:flex-1 tw:items-center tw:max-md:rounded-[8px]
                        tw:justify-center tw:rounded-xl tw:px-5 tw:text-center tw:text-[20px] tw:max-md:text-[16px]
                        tw:font-semibold tw:leading-[1.2] tw:no-underline tw:max-md:h-10
                      "
                    >
                      {{ block.settings.learn_more_btn_text | escape }}
                    </a>
                  {%- endif -%}

                  <button
                    type="button"
                    class="
                      event-minor-offer__add tw:flex tw:h-12 tw:flex-1 tw:items-center
                      tw:justify-center tw:rounded-xl tw:px-5 tw:text-center tw:text-[20px] tw:max-md:text-[16px]
                      tw:font-semibold tw:leading-[1.2] tw:max-md:h-10
                      tw:max-md:rounded-[8px]
                    "
                    data-add-to-cart
                    {% if product == blank or current_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    <span data-add-label>{{ block.settings.add_to_cart_text | default: 'add to cart' | escape }}</span>
                  </button>
                </div>
              </div>
            </div>
          </article>
